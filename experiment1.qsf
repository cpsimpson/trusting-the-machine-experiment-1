        "NewScoring": 1,
        "SurveyMetaDescription": "Survey about trust in written content.",
        "CustomStyles": {
          "customCSS": "\/* Content container *\/\n.trust-content-container {\n    font-family: 'Open Sans', sans-serif;\n    max-width: 850px;\n    margin: 50px auto;\n    background-color: #fff;\n    padding: 30px;\n    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);\n    border-radius: 12px;\n    transition: transform 0.3s ease;\n}\n\n.trust-content-container:hover {\n    transform: translateY(-5px);\n}\n\n\/* Avatar section *\/\n.avatar {\n    display: flex;\n    justify-content: center;\n    margin-bottom: 20px;\n}\n\n.avatar img {\n    width: 120px;\n    height: 120px;\n    border-radius: 50%;\n    object-fit: cover;\n    border: 3px solid #007bff;\n    transition: border 0.3s ease;\n}\n\n.avatar img:hover {\n    border: 3px solid #0056b3;\n}\n\n\/* Author description section *\/\n.author-description {\n    text-align: center;\n    margin-bottom: 40px;\n}\n\n.author-description h2 {\n    margin: 10px 0;\n    font-size: 24px;\n    color: #007bff;\n}\n\n.author-description p {\n    font-size: 16px;\n    color: #555;\n    line-height: 1.8;\n    padding: 0 20px;\n}\n\n\/* Blog post content section *\/\n.blog-post-content h1 {\n    font-size: 32px;\n    margin-bottom: 25px;\n    color: #333;\n    text-align: center;\n    position: relative;\n}\n\n.blog-post-content h1:after {\n    content: \"\";\n    display: block;\n    width: 60px;\n    height: 4px;\n    background-color: #007bff;\n    margin: 10px auto;\n    border-radius: 2px;\n}\n\n.blog-post-content p {\n    font-size: 18px;\n    line-height: 1.8;\n    margin-bottom: 25px;\n    color: #444;\n}\n\n.blog-post-content b {\n    color: #007bff;\n}\n\n\/* Add some spacing *\/\n.trust-content-container p {\n    margin-bottom: 1.5em;\n}"
        },
