      "Payload": {
        "QuestionText": "Welcome and thank you for taking the time to participate in this study.<br>\n<br>\nBefore the study starts, please silence your phone and <strong>ensure you are free from distractions for the next 15 minutes<\/strong>.<br>\n<br>\nDuring the study, you will read <b>the description of an author and a blog post they have written<\/b>. After reading this you will be asked a series of questions.<br>\n<br>\nBe sure to <strong>read the author description and blog post carefully before continuing<\/strong>&nbsp;as you will not be able to go back to read them again.&nbsp;<br>\n<br>\n&nbsp;",
        "DefaultChoices": false,
        "DataExportTag": "WelcomeText",
