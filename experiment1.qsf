      "SecondaryAttribute": "Study Title:\u00a0Perceptions of Communicated Information Faculty Supervisor:\u00a0Jonathan Fugelsang, PhD,.",
      "TertiaryAttribute": null,
      "Payload": {
        "ChoiceOrder": [
          1,
          2
        ],
        "Choices": {
          "1": {
            "Display": "I agree to participate."
          },
